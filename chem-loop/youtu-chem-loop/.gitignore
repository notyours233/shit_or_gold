################################################################################
# ChemCouncil ignore rules (synced copy)
#
# This file intentionally matches `../.gitignore` so the monorepo has a single
# ignore policy. If you change ignore rules, update the monorepo root file and
# copy the changes here as well.
################################################################################

# ---------------------------------------------------------------------------
# Python / build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

build/
dist/
*.egg-info/
.eggs/
wheels/

# ---------------------------------------------------------------------------
# Virtual environments
.venv/
**/.venv/
venv/
ENV/
env/

# ---------------------------------------------------------------------------
# Caches / test artifacts
.cache/
**/.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# IDE / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Secrets / local-only configuration
.env
.env.local
.env.*.local
.env.full.local
.env.full.private
.env.backup*
.local/

# ---------------------------------------------------------------------------
# Logs / outputs (generated)
logs/
**/logs/
outputs/
**/outputs/
results/
**/results/
exports/
**/exports/

# ---------------------------------------------------------------------------
# SQLite sidecars (keep main DB files like `test.db`)
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# ---------------------------------------------------------------------------
# Large local artifacts (not suitable for normal git hosting)
youtu-chem-loop/chroma_db/
youtu-chem-loop/chroma_db2/
youtu-chem-loop/test.db
test.db

# ---------------------------------------------------------------------------
# Subproject-specific large/generated artifacts
# MAD (debate/rank runtime)
MAD/data/chroma_db/
MAD/data/experience_db.json
MAD/data/raw/
# MAD experience sync artifacts (generated by youtu-chem-loop closed-loop helper)
MAD/experience/experience.yaml
MAD/experience/archive/
# Backward-compat: older workspace name (safe to keep even after rename).
MAD2/data/chroma_db/
MAD2/data/experience_db.json
MAD2/data/raw/

# Nested git repos (these directories exist during local development; remove them before publishing a single monorepo).
MAD/.git/
MAD2/.git/
