# ChemCouncil material-property server deployment template.
# Copy to `.env` on the server and fill real secrets.

# ------------------------------
# Public service
# ------------------------------
CHEMCOUNCIL_IMAGE=harbor.pic-aichem.online/wangzm/chemcouncil-material:20260902
CHEMCOUNCIL_PUBLIC_PORT=8000
CHEMCOUNCIL_HOST=0.0.0.0
CHEMCOUNCIL_PORT=8000
CHEMCOUNCIL_CORS_ORIGIN=*
# Optional. If set, API calls must include: Authorization: Bearer <token>
CHEMCOUNCIL_API_TOKEN=

# ------------------------------
# Host-mounted persistent data
# ------------------------------
# Mount point 1: small persistent state (SQLite DB, experience packs, job logs, uploads/results).
CHEMCOUNCIL_STATE_DIR=./state
# Mount point 2: large literature Chroma vector DB.
# This directory contains the unified literature collections used by MAD.
# The default shared deployment reads literature_agent2.
CHEMCOUNCIL_CHROMA_DIR=./chroma_db

# ------------------------------
# LLM provider for GRPO, recommendation and feedback distillation
# ------------------------------
UTU_LLM_TYPE=chat.completions
UTU_LLM_MODEL=deepseek-v4-pro
UTU_LLM_BASE_URL=https://agent-team-api.myrimate.cn/v1
UTU_LLM_API_KEY=
UTU_LLM_TEMPERATURE=1.0
UTU_LLM_MAX_TOKENS=2000
UTU_LOG_LEVEL=WARNING

# Current default mapping:
# - All four chat keys are sent to https://agent-team-api.myrimate.cn/v1.
# - OpenRouter is optional. It is only needed if MAD_RAG_MODE=per_agent is
#   enabled with the current agent1/agent3 embedding profiles.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
QWEN_API_KEY=
# OPENROUTER_API_KEY=

# ------------------------------
# Literature RAG / vector DB
# ------------------------------
MAD_ENABLE_RAG=1
# Server default: all agents reuse the Voyage-backed collection below. This
# avoids loading four large Chroma indexes and does not require OpenRouter.
MAD_RAG_MODE=shared
MAD_RAG_SHARED_AGENT=agent2
MAD_RAG_SHARED_COLLECTION=literature_agent2
MAD_RAG_SHARED_REACTION_COLLECTION=literature_agent2
MAD_RAG_REACTION_PERSIST_DIR=/app/MAD/data/chroma_db
CHEM_LITERATURE_CHROMA_COLLECTION=literature_agent2
MAD_RAG_LIMIT=5
MAD_RAG_MAX_DISTANCE=0.35
MAD_RAG_TIMEOUT_S=30

# Voyage is needed when querying the Chroma literature DB.
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3-large
VOYAGE_EMBED_INPUT_TYPE=

# ------------------------------
# Runtime / concurrency
# ------------------------------
# General background-job concurrency (experience generation/updates).
CHEMCOUNCIL_JOB_CONCURRENCY=1
# Material recommendation jobs are independent MAD processes. The UI accepts
# at most ten cards and submits them in parallel; lower this value if RAM/API
# limits require it.
CHEMCOUNCIL_RECOMMENDATION_CONCURRENCY=10
CHEMCOUNCIL_EXPERIENCE_BATCH_SIZE=19
CHEMCOUNCIL_EXPERIENCE_GRPO_N=3
CHEMCOUNCIL_EXPERIENCE_ROLLOUT_CONCURRENCY=4
CHEMCOUNCIL_EXPERIENCE_EPOCHS=1
CHEMCOUNCIL_FEEDBACK_ALIGNMENT_TIMEOUT_S=900

# Absolute DB path inside the container. Keep as-is for Docker.
UTU_DB_URL=sqlite:////state/test.db
SQLITE_TMPDIR=/tmp
TMPDIR=/tmp
