################################################################################
# ChemCouncil ignore rules (monorepo)
#
# Design goals:
# - Ignore secrets, local venvs, logs/outputs, and common Python caches.
# - Keep the repo GitHub-friendly by NOT tracking very large local artifacts
#   (e.g. Chroma DB and SQLite DB files). See README for how to rebuild/download.
################################################################################

# ---------------------------------------------------------------------------
# Python / build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

build/
dist/
*.egg-info/
.eggs/
wheels/

# ---------------------------------------------------------------------------
# Virtual environments
.venv/
**/.venv/
venv/
ENV/
env/

# ---------------------------------------------------------------------------
# Caches / test artifacts
.cache/
**/.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# IDE / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Secrets / local-only configuration
.env
.env.full
.env.local
.env.*.local
.env.full.local
.env.full.private
.env.backup*
.local/
state/

# ---------------------------------------------------------------------------
# Logs / outputs (generated)
logs/
**/logs/
outputs/
**/outputs/
results/
**/results/
exports/
**/exports/

# ---------------------------------------------------------------------------
# SQLite sidecars (keep main DB files like `test.db`)
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# ---------------------------------------------------------------------------
# Large local artifacts (not suitable for normal git hosting)
packages/
*.tar.gz
youtu-chem-loop/chroma_db/
youtu-chem-loop/chroma_db2/
youtu-chem-loop/test.db
test.db

# Lab experimental data (keep local by default)
样品中金属比例.xlsx
youtu-chem-loop/data/experimental/
youtu-chem-loop/data/processed/chem_performance_experimental/
# Imported literature-scale source data and generated audit queues stay local.
youtu-chem-loop/data/raw/
youtu-chem-loop/data/audits/
# Rebuildable 19-direction exports are tens of MB; keep code/contracts in Git.
youtu-chem-loop/data/processed/material_performance_19/

# ---------------------------------------------------------------------------
# Subproject-specific large/generated artifacts
# MAD (debate/rank runtime)
MAD/data/chroma_db/
MAD/data/chroma_db_legacy_split_*/
MAD/data/experience_db.json
MAD/data/raw/
# MAD experience sync artifacts (generated by youtu-chem-loop closed-loop helper)
MAD/experience/experience.yaml
MAD/experience/archive/
# Backward-compat: older workspace name (safe to keep even after rename).
MAD2/data/chroma_db/
MAD2/data/experience_db.json
MAD2/data/raw/

# Nested git repos (these directories exist during local development; remove them before publishing a single monorepo).
MAD/.git/
MAD2/.git/
