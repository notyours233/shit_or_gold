##################################################################################
# Monorepo env template (SAFE TO COMMIT)
#
# This workspace contains multiple subprojects:
# - youtu-chem-loop/      (training-free GRPO + experience distillation)
# - MAD/                 (multi-agent debate/rank system; also used as the rollout engine codebase)
#   (Consumes `experience.yaml` produced by youtu-chem-loop)
#
# Put real secrets in `.env` (gitignored).
##################################################################################

# =============================================
# youtu-chem-loop (GRPO / experience distillation)
# =============================================
# OpenAI-compatible API config used by youtu-chem-loop.
UTU_LLM_TYPE=chat.completions
UTU_LLM_MODEL=deepseek-v4-pro
UTU_LLM_BASE_URL=https://agent-team-api.myrimate.cn/v1
UTU_LLM_API_KEY=

# Optional knobs (used by MAD runner if set)
UTU_LLM_TEMPERATURE=1.0
UTU_LLM_MAX_TOKENS=2000

# DB / logging
UTU_DB_URL=sqlite:///test.db
UTU_LOG_LEVEL=WARNING

# SQLite temp dirs (recommended for Chroma/SQLite stability)
SQLITE_TMPDIR=/tmp
TMPDIR=/tmp

# =============================================
# chemcouncil (web backend wrapper; optional)
# =============================================
CHEMCOUNCIL_IMAGE=harbor.pic-aichem.online/wangzm/chemcouncil-material:20260902
CHEMCOUNCIL_HOST=0.0.0.0
CHEMCOUNCIL_PORT=8000
CHEMCOUNCIL_JOBS_ROOT=
# General background-job concurrency (experience generation/updates). Keep low
# unless you have enough RAM or API capacity.
CHEMCOUNCIL_JOB_CONCURRENCY=1
# Material recommendation jobs use a separate pool so a batch of up to ten
# cards can run in parallel. Lower this on small servers (for example 2 or 4).
CHEMCOUNCIL_RECOMMENDATION_CONCURRENCY=10
# Experience update defaults selected by the 19-direction held-out sweep.
CHEMCOUNCIL_EXPERIENCE_BATCH_SIZE=19
CHEMCOUNCIL_EXPERIENCE_GRPO_N=3
CHEMCOUNCIL_EXPERIENCE_ROLLOUT_CONCURRENCY=4
CHEMCOUNCIL_EXPERIENCE_EPOCHS=1
CHEMCOUNCIL_API_TOKEN=
CHEMCOUNCIL_CORS_ORIGIN=*

# =============================================
# Literature RAG (optional)
# =============================================
# youtu-chem-loop can use a local Chroma DB + Voyage embeddings for query embeddings.
CHEM_LITERATURE_BACKEND=chroma
# NOTE: this path is resolved relative to the youtu-chem-loop repo root (not this monorepo root).
# Recommended: reuse MAD's literature DB (persisted under ./MAD/data/chroma_db).
CHEM_LITERATURE_CHROMA_DIR=../MAD/data/chroma_db
# NOTE: MAD typically builds one Chroma collection per agent (suffix `_agentX`).
# youtu-chem-loop uses Voyage embeddings for queries, so default to the Voyage-built collection.
CHEM_LITERATURE_CHROMA_COLLECTION=literature_agent2
CHEM_LITERATURE_CHROMA_MAX_DISTANCE=0.35

VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3-large
VOYAGE_EMBED_INPUT_TYPE=

# =============================================
# MAD integration (external rollout engine)
# =============================================
# NOTE: these paths are interpreted from the youtu-chem-loop working directory.
MAD_REPO_PATH=../MAD
# Single-venv setup: reuse the monorepo venv python to run MAD.
MAD_PYTHON_BIN=../.venv/bin/python
# Default OFF for GitHub clones (the full literature Chroma DB is large and not tracked).
# Turn it ON only if you have a local literature Chroma DB (e.g. `MAD/data/chroma_db/`)
# and a valid VOYAGE_API_KEY.
MAD_ENABLE_RAG=0
MAD_RAG_LIMIT=5
MAD_RAG_MAX_DISTANCE=0.35
MAD_RAG_TIMEOUT_S=30
# RAG memory mode:
# - per_agent (default): one collection per agent (higher memory)
# - shared: all agents share ONE collection + ONE embedding profile (lower memory; good for WSL2/Docker testing)
MAD_RAG_MODE=
MAD_RAG_SHARED_AGENT=agent2
MAD_RAG_SHARED_COLLECTION=literature_agent2
MAD_RAG_SHARED_REACTION_COLLECTION=literature_agent2
MAD_RAG_REACTION_PERSIST_DIR=./data/chroma_db

# If MAD runner needs to call the chem literature runner via a specific python, you can
# override these with absolute paths. Usually you can leave them empty.
YOUTU_PYTHON_BIN=
YOUTU_CHEM_LITERATURE_RUNNER=

# =============================================
# MAD (debate/rank) keys
# =============================================
# MAD uses config/config.yaml with ${ENV_VAR} placeholders.
# Current default mapping:
# - All four chat keys are sent to https://agent-team-api.myrimate.cn/v1.
# - Agent1/agent3 literature embeddings use OpenRouter in per-agent RAG mode.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
QWEN_API_KEY=
OPENROUTER_API_KEY=
